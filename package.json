{
  "name": "stopwatch-companion",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "server": "node server/main.mjs",
    "bridge": "node bridge/main.mjs",
    "build": "node scripts/build.mjs",
    "build:preview": "node scripts/build.mjs --preview",
    "test:preview": "node tests/preview-browser.mjs",
    "mock:updates": "node scripts/mock-updates.mjs",
    "package:windows": "node scripts/package-windows.mjs --development",
    "test": "node --test --test-isolation=none tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "firmware:prepare": "node scripts/prepare-firmware.mjs",
    "protocol:check": "node scripts/check-codex-schema.mjs"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "0.25.12"
  }
}
