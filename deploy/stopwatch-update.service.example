[Unit]
Description=Apply a verified StopWatch portal release
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/stopwatch/production.env
Environment=STOPWATCH_HOME=%h/stopwatch
ExecStart=/usr/bin/flock -n %h/stopwatch/portal-update.lock /usr/bin/env node %h/stopwatch/bootstrap/scripts/portal-update.mjs --apply --locked
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
