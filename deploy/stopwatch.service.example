[Unit]
Description=StopWatch private relay (user service)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/stopwatch
EnvironmentFile=%h/stopwatch/production.env
Environment=STOPWATCH_HOME=%h/stopwatch
ExecStart=/usr/bin/env node bootstrap/scripts/portal-service.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
