CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_companion.csv"
CONFIG_MUSE_CJK_FONT=y
CONFIG_MUSE_CJK_FONT_NOTO=y
# CONFIG_MUSE_REALTIME_VOICE is not set
# CONFIG_HOMEHUB_OTA_ENABLED is not set
# The StopWatch board already enables PSRAM XIP, including code and rodata.
CONFIG_HOMEHUB_SETUP_TASKS_IN_PSRAM=y
# On-demand task snapshots in USB development diagnostics.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
# Measured nested Muse TLS/WSS boot path left only 388 B with 8 KiB.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=9216
CONFIG_LV_DEF_REFR_PERIOD=100
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# CONFIG_SECURE_BOOT is not set
# CONFIG_SECURE_FLASH_ENC_ENABLED is not set
CONFIG_SPIFFS_MAX_PARTITIONS=1
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
# CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK is not set
# CONFIG_HOMEHUB_NVS_ENCRYPTION is not set
# CONFIG_NVS_ENCRYPTION is not set
